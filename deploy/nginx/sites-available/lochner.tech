server {
    server_name lochner.tech www.lochner.tech news.lochner.tech;

    location / {
        proxy_pass http://127.0.0.1:8080;

        # Kubo's path gateway resolves content from the Host header via
        # DNSLink. Forcing the canonical host makes every domain in this
        # block serve the same IPNS name without a separate DNSLink record.
        proxy_set_header Host lochner.tech;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_cache off;
        proxy_read_timeout 120s;
    }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/lochner.tech/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/lochner.tech/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}
server {
    if ($host = news.lochner.tech) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = www.lochner.tech) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = lochner.tech) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name lochner.tech www.lochner.tech news.lochner.tech;
    return 404; # managed by Certbot




}
